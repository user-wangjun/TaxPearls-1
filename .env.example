# 填写后重启服务。进程环境变量优先于本文件；密钥仅由后端读取。
# 1) 必填：填入你购买的模型服务 API Key。
TAXPEARLS_AI_API_KEY=
# 2) 官方接口可保持不变；第三方网关请改成其基础地址，例如 https://example.com/v1。
# 不要包含 /chat/completions。不会自动把材料发送到其他备用服务。
TAXPEARLS_AI_BASE_URL=https://api.deepseek.com
# 官方地址下 ds-v4.1f 自动映射到官方名称 deepseek-flash；网关地址下原样传递。
TAXPEARLS_AI_MODEL=ds-v4.1f
TAXPEARLS_AI_ENABLED=0
# 支持 image_url 的视觉模型填 1；纯文本网关填 0（扫描件将提示不能识别）。
TAXPEARLS_AI_VISION=1
# 网关不支持 JSON 模式或 thinking 参数时，可分别设为 0。
TAXPEARLS_AI_JSON_MODE=1
TAXPEARLS_AI_DISABLE_THINKING=1
TAXPEARLS_AI_TIMEOUT=90
TAXPEARLS_AI_BATCH_TIMEOUT=300
TAXPEARLS_AI_MAX_TOKENS=8192
TAXPEARLS_AI_MAX_PAGES=12
TAXPEARLS_AI_MAX_CALLS=20

# 本机启动。容器内监听地址和数据库位置由 compose.yaml 覆盖。
TAXPEARLS_HOST=127.0.0.1
TAXPEARLS_PORT=8000
TAXPEARLS_DB=instance/taxpearls.db
# HTTPS 部署时改成 1；本机 HTTP 演示用 0。
TAXPEARLS_COOKIE_SECURE=0
# 邮件链接的可信站点地址。生产必填 HTTPS 源站（不带路径、查询或片段）。
# 本机留空时仅允许 localhost/127.0.0.1/::1；不从外部 Host 生成邮件链接。
TAXPEARLS_PUBLIC_BASE_URL=
# 反向代理与容器隔开时，填写代理连接应用时的固定源 IP；仅信任已知代理，不使用 *。
TAXPEARLS_TRUSTED_PROXY_IPS=127.0.0.1
# Windows 已安装 Chrome 用 chrome；Linux/容器使用 chromium。
TAXPEARLS_PDF_BROWSER=chrome


# Resend的key，用于邮箱注册
TAXPEARLS_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# 审计摘要邮件需显式启用，并由本人同意邮件订阅。默认仅使用站内通知。
TAXPEARLS_NOTIFICATION_EMAIL_ENABLED=0

# F10 encrypted backups: independent 32-byte random key, Base64 encoded.
# Keep outside backups; ops_db reads the process environment (not this file).
# Do not reuse provider keys or commit a real value. Empty disables encrypted backups.
TAXPEARLS_BACKUP_KEY=

# Enterprise original files and sensitive revision/event payloads: separate
# random 32-byte Base64 key. Keep outside DB/backups; loss prevents decryption.
# No automatic key generation, fallback or raw-file retention without this key.
TAXPEARLS_MATERIAL_KEY=
